<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VisorTurnos</RootNamespace>
    <AssemblyName>VisorTurnos.Web</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <Compile Remove="tools\**\*.cs" />
    <Content Remove="tools\**\*" />
    <None Remove="tools\**\*" />
  </ItemGroup>

  <Target Name="BuildClientApp" BeforeTargets="Compile" Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipClientAppBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp" Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp" Command="npm run build" />
  </Target>

</Project>
