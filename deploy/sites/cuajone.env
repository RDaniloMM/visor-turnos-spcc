# El despliegue copia este archivo como ".env" en la carpeta fisica de IIS de la
# sede Cuajone SOLO si no existe. La config local de la sede es autoritativa:
# si el sitio ya tiene un .env, este template nunca lo sobreescribe.
#
# Agregue la cadena de conexion ODBC de la sede (nunca commitearla):
#   ConnectionStrings__LolcliOdbc=DSN=LOLCLI9000;Trusted_Connection=Yes;
Site__Code=1
Site__DisplayName=Hospital SPCC Cuajone
Site__TimeZone=SA Pacific Standard Time