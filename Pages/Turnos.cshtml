@page
@model TurnosModel
@{ Layout = null; }
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#d22730" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Turnos de atencion</title>
    <link rel="stylesheet" href="~/css/tv.css" asp-append-version="true" />
</head>
<body data-stale-after-seconds="@Model.StaleAfterSeconds"
      data-max-visible-rows="@Model.MaxVisibleRows"
      data-area-rotation-seconds="@Model.AreaRotationSeconds">
    <div class="tv-shell">
        <header class="topbar">
            <div class="brand" aria-label="Centro medico">
                <span class="brand-mark" aria-hidden="true">
                    <img src="~/img/southern-peru-logo.png" asp-append-version="true" alt="" />
                </span>
                <div>
                    <p class="eyebrow">Bienvenidos</p>
                    <h1 id="site-name">Centro medico</h1>
                </div>
            </div>
            <div class="clock" aria-label="Fecha y hora actual">
                <p id="current-date">--</p>
                <time id="current-time">--:--</time>
            </div>
        </header>
        <main>
            <section id="callout" class="callout" aria-live="assertive">
                <div class="callout-copy">
                    <span id="called-label" class="callout-label">Llamando ahora</span>
                    <strong id="called-turn" class="called-patient">Preparando pantalla</strong>
                    <span id="called-message">En breve mostraremos los turnos</span>
                </div>
                <div class="room-card">
                    <span>Dirigirse a</span>
                    <strong id="called-room">—</strong>
                    <small id="called-doctor">—</small>
                </div>
            </section>
            <div class="boards-grid">
                <section class="board-panel area-panel" aria-labelledby="area-title">
                    <div class="board-titlebar area-titlebar">
                        <div>
                            <p class="board-kicker">Rotación por área</p>
                            <h3 id="area-title">Próximos por consultorio</h3>
                        </div>
                        <span id="area-counter" class="area-counter" aria-label="Posición del área">—</span>
                    </div>
                    <div class="area-context">
                        <strong id="area-room">Consultorio por confirmar</strong>
                        <span id="area-doctor">Dr. por confirmar</span>
                        <span id="area-status" class="area-status area-status--available">SIN DATOS</span>
                    </div>
                    <div class="area-table-head" aria-hidden="true">
                        <span>Paciente</span><span>Estado</span>
                    </div>
                    <div id="area-list" class="board-list area-list" role="list" aria-live="polite"></div>
                    <div id="area-empty" class="empty-state" hidden>
                        <strong>No hay próximos turnos</strong>
                        <span>Las áreas aparecerán automáticamente.</span>
                    </div>
                </section>

                <section class="board-panel general-panel" aria-labelledby="general-title">
                    <div class="board-titlebar general-titlebar">
                        <div>
                            <p class="board-kicker">Orden de atención</p>
                            <h3 id="general-title">Próximos turnos</h3>
                        </div>
                    </div>
                    <div class="general-table-head" aria-hidden="true">
                        <span>Paciente</span><span>Médico y consultorio</span><span>Estado</span>
                    </div>
                    <div id="general-list" class="board-list general-list" role="list" aria-live="polite"></div>
                    <div id="general-empty" class="empty-state" hidden>
                        <strong>No hay turnos para mostrar</strong>
                        <span>La pantalla se actualizará automáticamente.</span>
                    </div>
                </section>
            </div>
        </main>
        <footer>
            <p>Espere a que su turno sea llamado antes de acercarse al consultorio.</p>
            <p id="freshness">Última actualización: --</p>
        </footer>
    </div>
    <script src="~/js/signalr.min.js" asp-append-version="true" defer></script>
    <script src="~/js/tv.js" asp-append-version="true" defer></script>
</body>
</html>
